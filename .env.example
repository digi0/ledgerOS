# LedgerOS — environment variables
# Copy to .env.local (gitignored) and fill in. On Vercel, set these in
# Project Settings → Environment Variables.

# --- Supabase (required) -------------------------------------------------
# Public — safe in the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — admin key, bypasses RLS. NEVER expose to the browser,
# NEVER commit. Used for seed scripts + the ingestion pipeline writing
# rows on behalf of a firm.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direct Postgres connection (URI form, includes your DB password). Used
# ONLY by migrations + seed (supabase db push / seed script), never by the
# app at runtime. Settings → Database → Connection string → URI.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- Auth ----------------------------------------------------------------
# Flip to "true" once Supabase Auth is wired (rung 5). When "false" the
# route guard in src/proxy.ts is pass-through so local dev needs no login.
NEXT_PUBLIC_AUTH_ENABLED=false

# --- AI: copilot + parser fallback --------------------------------------
# Production: set ANTHROPIC_API_KEY → Claude. Local dev: leave unset →
# Ollama at OLLAMA_URL. The deterministic accounting-parser needs neither.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-4-5)
ANTHROPIC_MODEL=

# Local Ollama (only used when ANTHROPIC_API_KEY is unset)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# --- Gmail ingestion (added when the connector lands) -------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/gmail/callback
