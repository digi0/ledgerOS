# --- Core ---
ENV=dev
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ledgeros
POSTGRES_PASSWORD=ledgeros
POSTGRES_DB=ledgeros

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO local, S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ledgeros-documents

# --- Google OAuth (Gmail API) ---
# Fill these in after creating an OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
